# Neon → Connection string (Vercel'in Neon entegrasyonu bunu otomatik ekler)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# İsteğe bağlı: ilk hesaptan sonra da yeni kayıtlara izin vermek için "true" yap.
# ALLOW_SIGNUP=true

# ─── Ödeme hatırlatma bildirimleri (isteğe bağlı) ───────────────────────
# Anahtar üretmek için: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vercel Cron bu değeri "Authorization: Bearer ..." başlığıyla gönderir.
# Üretmek için: openssl rand -base64 32
CRON_SECRET=
