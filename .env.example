# Neon → Connection string (Vercel'in Neon entegrasyonu bunu otomatik ekler).
# Tek zorunlu değişken budur; şema her build'de otomatik uygulanır.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# İsteğe bağlı: tanımlanırsa hatırlatma zamanlayıcısı yalnızca bu anahtarla çağrılabilir.
# Tanımlanmazsa da güvenlidir (tekrar bildirim yok, 10 dakikada bir çalışma sınırı).
# CRON_SECRET=

# Bildirim anahtarları (VAPID) ilk ihtiyaçta otomatik üretilip veritabanında saklanır.
# Kendi anahtarını kullanmak istersen: NEXT_PUBLIC_VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
