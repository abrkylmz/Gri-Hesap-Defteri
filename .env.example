# Neon → Connection string (Vercel'in Neon entegrasyonu bunu otomatik ekler)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Neon Console → Auth → Configuration → Auth URL
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.eu-central-1.aws.neon.tech/neondb/auth
# En az 32 karakter rastgele değer. Üretmek için: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Şifre sıfırlama ve e-posta onayı bağlantılarının döneceği adres
NEXT_PUBLIC_SITE_URL=http://localhost:3000
